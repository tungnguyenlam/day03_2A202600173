# OPENAI SETTINGS
OPENAI_API_KEY="your_openai_api_key_here"

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
# Download model from: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf
LOCAL_MODEL_PATH="."

# HUGGING FACE LOCAL SETTINGS (Transformers)
# Example model: Qwen/Qwen2.5-0.5B-Instruct
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_MAX_NEW_TOKENS=512

# LAB CONFIG
# Options: openai | google | local | huggingface

# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o
# LOG_LEVEL=INFO
